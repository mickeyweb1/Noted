    return {
      sceneNumber: index + 1,
      narration: scene.narration.trim().slice(0, 500),
      visualPrompt: scene.visualPrompt.trim().slice(0, 500),
    };
  });
  return {
    title: typeof parsed.title === "string" && parsed.title.trim() ? parsed.title.trim().slice(0, 160) : "Video Storyboard",
    scenes,
  };
};

