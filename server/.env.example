PORT=5000
# Configure local MongoDB as a single-node replica set named rs0 for transactions.
MONGO_URI=mongodb://127.0.0.1:27017/noted?replicaSet=rs0
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
# Canonical public site URL used in sitemap output
SEO_SITE_URL=https://www.usenotedai.com
# Optional JSON array of additional public URL paths; never list private user content
SEO_PUBLIC_PATHS=[]
FLW_SECRET_KEY=
FLW_SECRET_HASH=
GAME_SHOW_OUTBOX_DIR=./data/game-show-outbox

# Configure the providers used by the features you enable.
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
HF_API_KEY=
# Optional model overrides for configured AI providers
GROQ_MODEL=
OPENROUTER_MODEL=
COHERE_MODEL=
NVIDIA_MODEL=
HF_MODEL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
REPLICATE_API_TOKEN=
OCR_SPACE_API_KEY=
